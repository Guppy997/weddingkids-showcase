# Kopieren nach .env:  cp .env.example .env
# Die Werte unten reichen, um die App lokal mit Demo-Daten zu starten.

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=3001

# Geheimer Schlüssel für Login-Tokens. Für echten Betrieb erzeugen mit:
#   openssl rand -hex 32
JWT_SECRET=nur-fuer-lokale-entwicklung-bitte-ersetzen

# Erlaubter Ursprung des Frontends (CORS)
CLIENT_ORIGIN=http://localhost:3000

# SQLite-Datei. Standard ohne Angabe: ./data/weddingkids.db
# Für die Demo:  npm run seed:demo  legt diese Datei mit erfundenen Daten an.
DB_PATH=./data/demo.db

# Account-IDs, kommagetrennt (optional):
#  HIDDEN_USER_IDS     → System-Accounts (Wartung/Test), überall unsichtbar
#  PROTECTED_USER_IDS  → Accounts, die nicht gelöscht werden können (Inhaber:innen)
HIDDEN_USER_IDS=
PROTECTED_USER_IDS=demo-lena,demo-sophie

# Web-Push (optional — ohne Keys sind Push-Benachrichtigungen aus).
# Erzeugen mit:  npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# ─── Frontend (Vite, wird beim Build eingesetzt) ─────────────────────────────
VITE_API_URL=http://localhost:3001
VITE_VAPID_PUBLIC_KEY=

# Impressum / Datenschutz (ohne Angabe erscheinen Platzhalter)
VITE_LEGAL_COMPANY_NAME=
VITE_LEGAL_REPRESENTED_BY=
VITE_LEGAL_STREET=
VITE_LEGAL_CITY=
VITE_LEGAL_COUNTRY=
VITE_LEGAL_EMAIL=
VITE_LEGAL_PHONE=
VITE_LEGAL_VAT_ID=
VITE_LEGAL_CONTENT_NAME=
VITE_LEGAL_CONTENT_STREET=
VITE_LEGAL_CONTENT_CITY=
